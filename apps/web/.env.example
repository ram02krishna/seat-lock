# Only needed when the API is NOT at http://localhost:4000 (these are the defaults).
# Copy to apps/web/.env for local development. In production set them in your hosting dashboard
# (for example Vercel); they are baked into the browser bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Production example:
# NEXT_PUBLIC_API_URL=https://your-api.onrender.com
# NEXT_PUBLIC_SOCKET_URL=https://your-api.onrender.com

{
  "name": "seat-lock",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "dev": "pnpm --filter @repo/shared build && pnpm --parallel --filter api --filter web dev",
    "build": "pnpm --recursive run build",
    "build:web": "pnpm --filter @repo/shared build && pnpm --filter web build",
    "build:api": "pnpm --filter @repo/shared build && pnpm --filter api build",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --filter @repo/shared build && pnpm --filter api prisma:generate && pnpm --recursive run typecheck",
    "db:push": "pnpm --filter api exec prisma db push",
    "db:migrate": "pnpm --filter api prisma:migrate",
    "db:seed": "pnpm --filter api prisma:seed",
    "seed": "pnpm --filter api prisma:seed",
    "db:studio": "pnpm --filter api prisma:studio",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:full": "docker compose --profile app up -d"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "typescript": "^5.7.3"
  }
}

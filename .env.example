# Copy to .env in the repository root:  cp .env.example .env
# Used by the API, the Prisma CLI commands and the seed script.
# The web app reads apps/web/.env instead (see apps/web/.env.example); its defaults already
# point at http://localhost:4000, so you only need that file if the API runs somewhere else.

# ---- API server ----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Comma-separated list of exact frontend origins allowed to call the API (cookies are sent, so
# no wildcards). In production list your real https origins, e.g.
#   CLIENT_URL=https://your-app.vercel.app
CLIENT_URL=http://localhost:3000
# Optional: where "View my tickets" links in emails point. Defaults to the first CLIENT_URL + /my-tickets.
# CLIENT_TICKETS_URL=https://your-app.vercel.app/my-tickets

# ---- Database (PostgreSQL) -----------------------------------------------------------------
# WITH Docker (`docker compose up -d` publishes PostgreSQL on port 5433):
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/seat_lock?schema=public
# WITHOUT Docker, use your own PostgreSQL instead (local install on 5432, or Neon / Supabase):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/seat_lock?schema=public
# DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/seat_lock?sslmode=require

# ---- Redis ---------------------------------------------------------------------------------
# WITH Docker (or any Redis server):
REDIS_URL=redis://localhost:6379
# WITHOUT Docker: 'mock' uses a built-in in-memory Redis. Holds still expire (a 60-second database
# sweep releases them), but nothing is shared between processes, so use real Redis in production.
# REDIS_URL=mock

# ---- Auth ----------------------------------------------------------------------------------
# Local development only. In production use a unique random secret of at least 32 characters.
JWT_SECRET=supersecretdevkey1234567890_min32chars

# Organizer account created on API start-up when no organizer exists yet.
# Production requires your own email and a unique password of at least 8 characters.
ORGANIZER_EMAIL=organizer@eventseat.com
ORGANIZER_PASSWORD=password123

# ---- Email (Resend) ------------------------------------------------------------------------
# Optional in development (verification codes are returned by the API and printed in its log);
# required in production for sign-up and password reset.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# Sender on a domain verified with Resend. Defaults to Resend's shared sandbox sender.
# RESEND_FROM_EMAIL=SeatLock <tickets@your-domain.com>
# Optional separate sender for ticket emails (defaults to RESEND_FROM_EMAIL).
# RESEND_TICKETS_FROM_EMAIL=SeatLock Tickets <tickets@your-domain.com>
# The Resend sandbox only delivers to your own Resend account address; set this to forward every
# email there while testing.
# RESEND_OVERRIDE_EMAIL=you@example.com
# Optional: QR image service used inside emails (the ticket code is appended URL-encoded).
# QR_CODE_API_URL=https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=

# ---- docker-compose.yml overrides (all optional) -------------------------------------------
# POSTGRES_PORT=5433
# REDIS_PORT=6379
# DOCKER_API_PORT=4000
# DOCKER_WEB_PORT=3001
=======
# Backend Server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (e.g. localhost, Vercel domain, custom domain)
# Example: CLIENT_URL=http://localhost:3000,https://seatlock-event-seat-booking.vercel.app
# Optional: URL attendees are directed to view tickets (defaults to https://seatlock-event-seat-booking.vercel.app/my-tickets)
# CLIENT_TICKETS_URL=https://seatlock-event-seat-booking.vercel.app/my-tickets
CLIENT_URL=http://localhost:3000

# Database (Required for backend):
# Option A (Without Docker - Native local PostgreSQL on port 5432):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/seat_lock?schema=public
# Option B (Without Docker - Free Cloud PostgreSQL e.g. Neon / Supabase):
# DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/seat_lock?sslmode=require
# Option C (With Docker - Port 5433 mapped via docker-compose):
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/seat_lock?schema=public

# Redis / Cache:
# Option A (Without Docker): set to 'mock' for built-in in-memory Redis (zero external dependencies!)
# REDIS_URL=mock
# Option B (With Docker or local/cloud Redis server):
REDIS_URL=redis://localhost:6379

# Local development only; replace with a unique random 32+ character secret in production.
JWT_SECRET=supersecretdevkey1234567890_min32chars

# Local development only: organizer created on server start if not present.
# Production requires a dedicated email and a unique password of at least 8 characters.
ORGANIZER_EMAIL=organizer@eventseat.com
ORGANIZER_PASSWORD=password123

# Email (Resend) - Optional in development; required in production for signup/password reset.
RESEND_API_KEY=re_your_api_key_here
# Sender address verified with Resend:
RESEND_FROM_EMAIL=SeatLock <tickets@domain.me>
# Optional: In Resend free sandbox, emails can ONLY be sent to your registered Resend account email.
# Set RESEND_OVERRIDE_EMAIL to that registered email to forward all test emails there.
# RESEND_OVERRIDE_EMAIL=your_resend_email@example.com

# Frontend (Vercel Environment Variables)
# In development:
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# In production on Vercel:
# NEXT_PUBLIC_API_URL=https://your-api.onrender.com
# NEXT_PUBLIC_SOCKET_URL=https://your-api.onrender.com
